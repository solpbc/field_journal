        "  @dataclass",
        "  class InspectionEvent:",
        "+     schema_version: int",
        "      site_id: str",
        "      inspector: str",
        "      photos: list[str]",
        "      findings: list[str]",
        "      signed_at: datetime",
        "+ ",
        "+ CURRENT_SCHEMA_VERSION = 1"
      ]
    },
    {
      "file": "bridge/queue.py",
      "lines": [
        "+ class LocalQueue:",
        "+     def __init__(self, path):",
        "+         self.store = open_store(path)",
        "+ ",
        "+     def push(self, event):",
        "+         event.schema_version = CURRENT_SCHEMA_VERSION",
        "+         self.store.append(event)",
        "+ ",
        "+     def drain(self, send):",
        "+         delay = 1",
        "+         while self.store.peek():",
        "+             try:",
        "+                 send(self.store.peek())",
        "+                 self.store.pop()",
        "+                 delay = 1",
        "+             except MeshUnavailable:",
        "+                 sleep(delay)",
        "+                 delay = min(delay * 2, 300)"
      ]
    },
    {
      "file": "bridge/sync.py",
